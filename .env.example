# Supabase project → Settings → API. Copy to .env.local and fill in.
# All three are read on the server only; none is exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public reads (anon / publishable key). RLS limits it to published rows.
SUPABASE_ANON_KEY=
# Dashboard reads drafts and publishes with this key (service_role / secret key).
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2: where dashboard uploads are stored.
# Endpoint is the account origin (no bucket in the path).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=riflesso
# R2 → Manage API tokens → Create token with Object Read & Write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Where the bucket is served from: an r2.dev development URL or a custom
# domain. Public by nature — the browser loads images from it.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-<hash>.r2.dev

# Optional. The site's public origin, no trailing slash, for canonical links,
# share pictures, sitemap.xml and robots.txt. Unset: production builds use
# https://riflesso.vn (src/lib/seo/site-url.ts), `next dev` uses localhost.
# Set it only for another domain, e.g. staging. Inlined at build time.
# NEXT_PUBLIC_SITE_URL=https://staging.riflesso.vn
